# Facebook API Credentials Template
# Copy this file to .facebook_credentials.env and fill in your values

# Facebook App Credentials (from Facebook Developer Portal)
FACEBOOK_APP_ID= app id
FACEBOOK_APP_SECRET= app secret
FACEBOOK_PAGE_ID= page id

# Access Tokens (from Graph API Explorer)
FACEBOOK_USER_TOKEN= user token here
FACEBOOK_PAGE_TOKEN= page token here

# ⚠️ IMPORTANT:
# 1. Never commit this file to Git (it's in .gitignore)
# 2. Keep your tokens secret
# 3. Refresh tokens every 60 days
# 4. For help, see FACEBOOK-SETUP-GUIDE.md
