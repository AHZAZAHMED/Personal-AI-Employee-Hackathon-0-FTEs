[Unit]
Description=AI Employee Facebook Watcher - Monitor Facebook Page for mentions
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
Group=YOUR_GROUP
WorkingDirectory=/path/to/Personal-AI-Employee-Hackathon-0-FTEs/Gold-Tier
Environment="PATH=/usr/bin:/usr/local/bin"
ExecStart=/usr/bin/python3 skills/facebook_watcher/watcher.py --vault AI_Employee_Vault --check-interval 300

# Auto-restart configuration
Restart=always
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=300

# Resource limits (optional)
# MemoryLimit=256M
# CPUQuota=25%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-employee-facebook-watcher

# Security hardening (optional)
# NoNewPrivileges=true
# PrivateTmp=true
# ProtectSystem=strict
# ProtectHome=read-only
# ReadWritePaths=/path/to/AI_Employee_Vault

[Install]
WantedBy=multi-user.target
