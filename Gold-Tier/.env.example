# ============================================================================
# AI EMPLOYEE - GOLD TIER ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git - it contains sensitive secrets
#
# Security Best Practices:
# 1. Set restrictive permissions: chmod 600 .env
# 2. Rotate all keys immediately if exposed
# 3. Use secrets manager for production (AWS Secrets Manager, Azure Key Vault)
# 4. Never share credentials via email, Slack, or other channels
# ============================================================================

# ============================================================================
# FACEBOOK / META CREDENTIALS
# ============================================================================
# Get these from: https://developers.facebook.com/apps/
# Required for: facebook_posting, facebook_watcher skills
FACEBOOK_APP_ID=your_app_id_here
FACEBOOK_APP_SECRET=your_app_secret_here
FACEBOOK_PAGE_ID=your_page_id_here

# Access Tokens (from Graph API Explorer: https://developers.facebook.com/tools/explorer/)
FACEBOOK_USER_TOKEN=your_user_token_here
FACEBOOK_PAGE_TOKEN=your_page_token_here

# ============================================================================
# INSTAGRAM CREDENTIALS
# ============================================================================
# Get these from: https://developers.facebook.com/apps/
# Required for: instagram_posting, instagram_watcher skills
INSTAGRAM_APP_ID=your_app_id_here
INSTAGRAM_BUSSINESS_ACCOUNT_ID=your_business_account_id_here
INSTAGRAM_USER_TOKEN=your_user_token_here

# ============================================================================
# TWITTER / X CREDENTIALS
# ============================================================================
# Get these from: https://developer.twitter.com/en/portal/dashboard
# Required for: twitter_posting skill
SECRET_KEY=your_secret_key_here
BEARER_TOKEN=your_bearer_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here

# ============================================================================
# TWILIO CREDENTIALS (WhatsApp)
# ============================================================================
# Get these from: https://console.twilio.com/
# Required for: whatsapp skill, whatsapp_watcher
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ============================================================================
# NEON DATABASE (PostgreSQL)
# ============================================================================
# Get this from: https://console.neon.tech/
# Required for: whatsapp_watcher (stores message history)
NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ============================================================================
# GOOGLE AI (GEMINI)
# ============================================================================
# Get this from: https://makersuite.google.com/app/apikey
# Required for: AI response generation (primary, free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# ANTHROPIC (CLAUDE)
# ============================================================================
# Get this from: https://console.anthropic.com/settings/keys
# Required for: AI response generation (fallback, paid)
# Note: Can use local Kiro/Claude Code proxy instead
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=http://127.0.0.1:3456  # Uncomment for local proxy

# For Kiro/Claude Code Proxy Setup (optional)
# PROXY_API_KEY=your_proxy_api_key_here
# KIRO_CREDS_FILE=~/.aws/sso/cache/kiro-auth-token.json

# ============================================================================
# GMAIL API CREDENTIALS
# ============================================================================
# Get credentials.json from: https://console.cloud.google.com/apis/credentials
# Required for: gmail_watcher, email_responder skills
# Note: credentials.json file should be in project root (gitignored)
# First run will open browser for OAuth consent

# ============================================================================
# ODOO ERP CREDENTIALS
# ============================================================================
# Required for: odoo_accounting, email_to_invoice skills
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin123@example.com
ODOO_PASSWORD=admin

# ============================================================================
# LINKEDIN CREDENTIALS
# ============================================================================
# Get these from your LinkedIn account
# Required for: linkedin_posting skill
LINKEDIN_EMAIL=your_linkedin_email_here
LINKEDIN_PASSWORD=your_linkedin_password_here

# ============================================================================
# SECURITY WARNINGS
# ============================================================================
# ⚠️  NEVER commit .env with real credentials to git
# ⚠️  Rotate ALL keys immediately if this file is exposed
# ⚠️  Use environment-specific files (.env.dev, .env.prod)
# ⚠️  For production, use a secrets manager (not .env files)
# ⚠️  Set file permissions: chmod 600 .env (read/write owner only)
