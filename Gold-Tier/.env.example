# Facebook App Credentials (from Facebook Developer Portal)
FACEBOOK_APP_ID=your_app_id_here
FACEBOOK_APP_SECRET=your_app_secret_here
FACEBOOK_PAGE_ID=your_page_id_here

# Access Tokens (from Graph API Explorer)
FACEBOOK_USER_TOKEN=your_user_token_here
FACEBOOK_PAGE_TOKEN=your_page_token_here

# Instagram App Credentials (from Facebook Developer Portal)
INSTAGRAM_APP_ID=your_app_id_here
INSTAGRAM_BUSSINESS_ACCOUNT_ID=your_business_account_id_here
INSTAGRAM_USER_TOKEN=your_user_token_here

# Twitter App Credentials (from Twitter Developer Portal)
SECRET_KEY=your_secret_key_here
BEARER_TOKEN=your_bearer_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Neon Database Configuration
NEON_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Claude AI Configuration - Using Local Kiro/Claude Code Proxy
ANTHROPIC_API_KEY=dummy-key-for-local-proxy
ANTHROPIC_BASE_URL=http://127.0.0.1:3456

# For Kiro setup
PROXY_API_KEY=your_proxy_api_key_here
KIRO_CREDS_FILE=~/.aws/sso/cache/kiro-auth-token.json

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Odoo ERP Configuration (REQUIRED for odoo_accounting and email_to_invoice skills)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin123@example.com
ODOO_PASSWORD=admin
